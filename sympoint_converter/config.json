{
  "_doc": "SymPointV2 approach (approach 2). Lengths in metres of the normalised drawing.",
  "tile_m": 20.0,
  "overlap_m": 4.0,
  "max_primitives_per_tile": 40000,
  "min_primitive_length_m": 0.0001,
  "include_hatch_boundaries": false,
  "min_label_score": 0.35,
  "min_label_mass": 0.2,
  "request_tiles_per_call": 8,
  "timeout_s": 1800,
  "cache_labels": true,
  "service": {
    "_doc": "Local SymPointV2 service. 'home' = SymPointV2 checkout (SYMPOINT_HOME overrides), 'env' = its conda env. The CLI starts the service in the background when it is not running and keeps sympoint_server.py up to date. 'python' = explicit interpreter instead of the conda env (optional).",
    "url": "http://127.0.0.1:8790",
    "home": "~/sympointv2",
    "env": "sympoint",
    "python": null,
    "config": [
      "svg_pointT_release.yaml",
      "configs/svg/svg_pointT.yaml"
    ],
    "checkpoint": [
      "weights.pth",
      "best.pth"
    ],
    "autostart": true,
    "start_timeout_s": 240,
    "sync_server": true
  },
  "build": {
    "_doc": "Turning labels into walls / openings / columns / stairs (see extract.py).",
    "min_wall_share": 0.5,
    "min_face_length_m": 0.05,
    "wall_thickness_m": [
      0.04,
      0.9
    ],
    "plausible_thickness_m": [
      0.07,
      0.6
    ],
    "parallel_deg": 1.0,
    "min_overlap_m": 0.05,
    "column_size_m": [
      0.15,
      1.5
    ],
    "short_piece_factor": 1.0,
    "single_line_max_paired_share": 0.3,
    "single_line_min_length_m": 0.3,
    "nominal_thickness_m": 0.15,
    "symbol_cluster_gap_m": 0.08,
    "min_instance_score": 0.5,
    "host_search_m": 0.6,
    "unhosted_doors": false,
    "door_width_m": [
      0.45,
      3.6
    ],
    "window_width_m": [
      0.3,
      8.0
    ],
    "stair_cluster_gap_m": 0.4,
    "min_tread_m": 0.5,
    "min_treads": 3,
    "going_m": [
      0.15,
      0.5
    ],
    "railing_thickness_m": [
      0.02,
      0.35
    ],
    "railing_min_length_m": 0.3,
    "gap_min_share": 0.5,
    "gap_min_labelled_m": 0.3
  },
  "reasoning": {
    "_doc": "Reasoning on top of the model's answer (sympoint_converter/reasoning/). Every module can be switched off; none reads drawing-specific names or sizes.",
    "label_consensus": {
      "_doc": "Blocks, layers and layer names vote on the line labels (label_consensus.py).",
      "enabled": true,
      "keep_model_score": 0.8,
      "blocks": {
        "enabled": true,
        "min_labelled_share": 0.5,
        "min_purity": 0.7,
        "symbol_max_size_m": 6.0,
        "whole_min_coverage": 0.3,
        "whole_min_purity": 0.7
      },
      "layers": {
        "enabled": true,
        "min_entities": 10,
        "min_length_m": 5.0,
        "fill_min_coverage": 0.25,
        "fill_min_purity": 0.85,
        "fill_score": 0.6,
        "background_max_coverage": 0.03,
        "background_max_coverage_named": 0.15,
        "fill_min_coverage_wall": 0.5
      },
      "names": {
        "enabled": true,
        "min_name_score": 0.6,
        "score": 0.5
      },
      "min_entity_labelled_share": 0.3
    },
    "wall_structure": {
      "_doc": "Wall groups that enclose no room and host no door / window (wall_structure.py): small or far groups are rejected, others kept for review.",
      "enabled": true,
      "small_group_max_walls": 6,
      "small_group_max_length_m": 20.0,
      "far_from_rooms_m": 3.0,
      "far_group_max_walls": 20,
      "far_group_max_length_m": 60.0
    }
  },
  "engine_overrides": {
    "_doc": "Merged into approach 1's configuration for the shared build stages: weights of the evidence approach 2 produces, and the shared reasoning rules approach 2 switches on (approach 1's own config files are not changed).",
    "detection": {
      "weights": {
        "wall": {
          "sympoint_label": 2.5,
          "sympoint_faces": 1.0,
          "sympoint_thickness": 0.6
        },
        "door": {
          "sympoint_label": 3.0
        },
        "window": {
          "sympoint_label": 3.0
        },
        "column": {
          "sympoint_label": 2.0
        },
        "stair": {
          "sympoint_label": 2.0,
          "sympoint_regularity": 1.0
        }
      }
    },
    "phase2": {
      "stack_levels": false,
      "ground": {
        "wide_close_m": [
          4.0,
          6.0
        ],
        "min_enclosure": 0.6
      }
    },
    "reconstruction": {
      "label_rules": {
        "enabled": true
      }
    }
  }
}
